MAINNET_RPC_URL=
FUSE_RPC_URL=

DEPLOYER=
PRIVATE_KEY=

# ETH
VAULT=
ETHEREUM_TELLER=
WETH=
UNISWAP_V3_POSITION=

# FUSE
VAULT_FUSE=
FUSE_TELLER=
WETH_FUSE=

# --- Rewards v3 (script/DeploySolidRewards.s.sol) ---
# See src/solid-rewards/DEPLOYMENT.md. Every one of these is read at deploy time
# and three of them are burned in immutably, so check them against the chain
# before broadcasting rather than after.

# Owner of both contracts. The Safe multisig, NOT the deployer EOA — the deployer
# holds no rights once the constructor has run.
OWNER=
# soFUSE BoringVault, i.e. the share token the lock escrows. 18 decimals.
SOFUSE_VAULT=
# Its AccountantWithRateProviders — priced through getRate() for display only.
SOFUSE_ACCOUNTANT=
# Billing asset. IMMUTABLE on the module. Fuse USDC.e, 6 decimals.
USDC=
# The only address the module can ever pay. IMMUTABLE. A wrong value here cannot
# be corrected — the module has to be replaced.
REVENUE_TREASURY=
# Lock term in seconds. 31536000 = 365 days. Changeable later, and a change
# never reaches a lock already taken.
LOCK_DURATION_SECONDS=31536000
# Smallest lock accepted, in shares (18 dp). 1000000000000000000 = 1 share.
MIN_LOCK_SHARES=1000000000000000000
# Org-wide ceiling on one charge, in USDC base units. 500000000 = 500 USDC.
# Binds existing mandates when lowered, so it is also the live throttle.
MAX_CHARGE_AMOUNT=500000000

DEPOSIT_LISTENER_MODE=

# --- AI API billing (script/DeploySolidUsageBilling.s.sol, Base 8453) ---
# See src/solid-billing/DEPLOYMENT.md. Two of these are immutable once deployed:
# AI_BILLING_TREASURY and AI_BILLING_MIN_PERIOD.
BASE_RPC_URL=
# Owner of the module. Prod: the Base Safe, NOT the Fuse one (no code on Base).
AI_BILLING_OWNER=
# QA only: let an EOA own the module. Unset, the script refuses an owner that isn't a
# Safe needing 2+ signatures.
# AI_BILLING_ALLOW_EOA_OWNER=true
# The only address the module can ever pay. IMMUTABLE.
AI_BILLING_TREASURY=
# Org ceiling on one charge, in micro-USD. 1000000000 = $1,000. Live throttle.
AI_BILLING_MAX_CHARGE_AMOUNT=1000000000
# Shortest period a mandate's cap may apply to, seconds. IMMUTABLE. 86400 = a day.
AI_BILLING_MIN_PERIOD=86400
# Billing tokens in draw order, and one rate provider each (0x0 = a dollar at par).
AI_BILLING_TOKENS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AI_BILLING_RATE_PROVIDERS=0x0000000000000000000000000000000000000000
