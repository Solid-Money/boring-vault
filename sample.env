MAINNET_RPC_URL=
FUSE_RPC_URL=

DEPLOYER=
PRIVATE_KEY=

# ETH
VAULT=
ETHEREUM_TELLER=
WETH=
UNISWAP_V3_POSITION=

# FUSE
VAULT_FUSE=
FUSE_TELLER=
WETH_FUSE=

DEPOSIT_LISTENER_MODE=

# ============================================================================
# SolidCashModuleV2 on Base — EURC spending
# script/spend-module/v2/base/README.md
#
# Foundry loads .env from the project root automatically, so `vm.envOr` in the
# deploy scripts reads these with no flags on the command line.
# ============================================================================

BASE_RPC_URL=

# Timelocked multisig. Owns the module, the authority, the provider and the adapter.
OWNER=

# Backend sweep key. Holds SPENDER_ROLE.
SPENDER=
# Optional, defaults to SPENDER. The role split is permanent; the key split is a grant.
CREDIT_SPENDER=

# Pause key. Must be its own address — a brake wired to the thing it stops is not a brake.
GUARDIAN=

# Drives SolidLiquidator. Must NOT be either spender key: that separation is the only
# reason a manufactured liquidation needs two independent compromises.
LIQUIDATION_OPERATOR=

# Immutable in both module halves. A wrong value is a redeploy plus a re-consent
# transaction from every registered Safe.
SETTLEMENT_TREASURY=

# --- Base addresses. None have a default; the scripts refuse to run without them. ---

EURC_ADDRESS=
EURC_USD_FEED=

# Chainlink's L2 sequencer uptime feed. Required on Base, not optional: while the
# sequencer is down every feed keeps returning its last answer with a recent
# timestamp, so a staleness bound catches nothing.
SEQUENCER_UPTIME_FEED=

# --- Optional, sensible defaults in code ---

# Seconds after the sequencer recovers before prices are trusted. Default 3600.
# Too short prices off feeds frozen during the outage; too long kills the card
# after every blip.
# SEQUENCER_GRACE_PERIOD=3600

# Heartbeat bound on EURC/USD. Default 86400. Must match the feed's real heartbeat.
# EURC_USD_MAX_STALENESS=86400

# Reuse an existing RolesAuthority instead of deploying one. Left unset by default:
# Base already has one from the LBTC vault, and sharing it would mean a role granted
# for a vault reaches a card module.
# AUTHORITY=

# The v1Module immutable on a chain with no v1. Defaults to the burn address.
# V1_MODULE_SENTINEL=0x000000000000000000000000000000000000dEaD

# --- Linked libraries, filled in after step 2 of the runbook ---
# SPENDING_LIMIT_LIB_V2=
# SOLID_CREDIT_MATH_LIB=
# SOLID_CASH_CONFIG_LIB=
